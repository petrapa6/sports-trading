{
  "name": "kalshi-trader",
  "version": "0.1.0",
  "private": true,
  "description": "In-game sports strategy trader for Kalshi with dry-run mode and backtesting",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "node dist/server/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "audit:security": "vitest run test/security && npm audit --audit-level=high",
    "verify:T01": "tsx scripts/verify-T01.ts",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
