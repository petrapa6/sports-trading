{
  "name": "kalshi-trader",
  "version": "0.0.1",
  "private": true,
  "description": "In-game sports strategy trader for Kalshi with dry-run mode and backtesting",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite",
    "start": "node dist/server/main.js",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:web": "vite build",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "audit:security": "tsx scripts/audit-security.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts up",
    "db:migrate:down": "tsx scripts/db-migrate.ts down",
    "db:studio": "drizzle-kit studio",
    "prepare": "node scripts/install-hooks.mjs",
    "check:addon": "tsx scripts/check-addon-config.ts",
    "verify:image": "tsx scripts/verify-image.ts",
    "compose:options": "tsx scripts/compose-options.ts",
    "kalshi:smoke": "tsx scripts/kalshi-smoke.ts",
    "fixtures:record:kalshi": "tsx scripts/record-kalshi-fixtures.ts",
    "replay": "tsx scripts/replay.ts",
    "feeds:smoke": "tsx scripts/feeds-smoke.ts",
    "fixtures:record:feeds": "tsx scripts/record-feed-fixtures.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "import:nhl": "tsx scripts/import-nhl.ts",
    "e2e:demo": "tsx scripts/e2e-demo.ts",
    "seed:season": "tsx scripts/seed-season.ts",
    "lighthouse:a11y": "tsx scripts/lighthouse-a11y.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/csrf-protection": "^8.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
